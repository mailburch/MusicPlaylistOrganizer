@model IEnumerable<MusicPlaylistOrganizer.Models.Playlist>

@{
    ViewData["Title"] = "Playlists";
    var currentSearch = ViewData["CurrentFilter"] as string;
    var trackFilter   = (ViewData["CurrentTrackFilter"] as string) ?? "all";
}

<h1>Playlists</h1>

<form asp-action="Index" method="get" class="form-inline" style="margin-bottom:15px;">
    <input type="text"
           name="searchString"
           value="@currentSearch"
           class="form-control"
           placeholder="Search by name or description..."
           style="max-width:260px; display:inline-block;" />

    <select name="trackFilter" class="form-control" style="max-width:200px; display:inline-block; margin-left:8px;">
        <option value="all" selected="@(trackFilter == "all")">All Playlists</option>
        <option value="empty" selected="@(trackFilter == "empty")">Empty Only</option>
        <option value="nonempty" selected="@(trackFilter == "nonempty")">With Tracks Only</option>
    </select>

    <button type="submit" class="btn btn-outline-primary" style="margin-left:8px;">Apply</button>
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Playlist</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["NameSortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-trackFilter="@trackFilter">
                    Name
                </a>
            </th>
            <th>Description</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["CountSortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-trackFilter="@trackFilter">
                    Tracks
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var playlist in Model)
    {
        <tr>
            <td>@playlist.Name</td>
            <td>@playlist.Description</td>
            <td>@(playlist.PlaylistTracks?.Count ?? 0)</td>
            <td>
                <a asp-action="Details" asp-route-id="@playlist.PlaylistID">Details</a> |
                <a asp-action="Edit" asp-route-id="@playlist.PlaylistID">Edit</a> |
                <a asp-action="Delete" asp-route-id="@playlist.PlaylistID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
