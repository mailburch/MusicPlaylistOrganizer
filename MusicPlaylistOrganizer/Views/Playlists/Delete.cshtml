@model MusicPlaylistOrganizer.Models.Playlist

@{
    ViewData["Title"] = "Delete Playlist";
}

<h1>Delete Playlist</h1>
<div class="container-md">
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-6 ps-5 pe-5 p-3 bg-blue" style="border-color: red; border-width: 2px; border-radius: 1rem; border-style: solid;">
            <div>
                <h2 class="text-danger">Delete Playlist?</h2>

<p class="text-mute m-0">This will remove the <strong>@Model.Name</strong> playlist, but keep all tracks in your library.</p>
<p class="text-mute">Are you sure?</p>

<div>
        <p class="text-mute">Tracks in this playlist:
                        <strong class="text-light">@(Model.PlaylistTracks?.Count ?? 0)</strong>
                    </p>
</div>

<form asp-action="Delete" method="post" style="margin-top:15px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PlaylistID" />
    <button type="submit" class="btn btn-delete mt-5 me-5 ps-5 pe-5" style="border-radius: 2rem;">Delete Playlist</button>
    <a asp-action="Index" class="btn btn-other mt-5 me-5 ps-5 pe-5" style="border-radius: 2rem;">Cancel</a>
</form>
