@model MusicPlaylistOrganizer.Models.Playlist

@{
    ViewData["Title"] = "Delete Playlist";
}

<h1>Delete Playlist</h1>

<h3>Are you sure you want to delete this playlist?</h3>

<div>
    <h2>@Model.Name</h2>
    <p>@Model.Description</p>

    <p>
        <strong>Tracks in this playlist:</strong>
        @Model.PlaylistTracks?.Count ?? 0
    </p>

    @if (Model.PlaylistTracks != null && Model.PlaylistTracks.Any())
    {
        <ul>
            @foreach (var pt in Model.PlaylistTracks.OrderBy(pt => pt.Position))
            {
                <li>@pt.Position. @pt.Track.Title (@pt.Track.Artist.Name)</li>
            }
        </ul>
    }
</div>

<form asp-action="Delete" method="post" style="margin-top:15px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PlaylistID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
