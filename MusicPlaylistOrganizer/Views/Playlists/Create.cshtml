@model MusicPlaylistOrganizer.Models.Playlist

@{
    ViewData["Title"] = "Add Playlist";
}

<h1>Add Playlist</h1>
<div class="container-md">
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <div class="bg-blue p-4" style="border-radius: 1rem; height:100%;">
                <h5>Create Playlist</h5>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Name"></label>
                                <input asp-for="Name" class="form-control formField" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group" style="margin-top:10px;">
                                <label asp-for="Description"></label>
                                <textarea asp-for="Description" class="form-control formField"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div style="margin-top:15px;">
                                <button type="submit" class="btn btn-blue">Save Playlist</button>
                                <a asp-action="Index" class="btn btn-mute">Cancel</a>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <p class="text-mute m-0">Artwork Placeholder</p>
                            <img src="~/Images/NoArtwork.jpg" style="width:150px; height: 150px; object-fit: cover; border-radius: 8px;" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
</div>