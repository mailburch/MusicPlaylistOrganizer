@model MusicPlaylistOrganizer.Models.Track

@{
    ViewData["Title"] = "Delete Track";
    var duration = TimeSpan.FromSeconds(Model.DurationSeconds);
}

<h1>Delete Track</h1>

<div style="display:flex; gap:15px; align-items:flex-start; margin-bottom:20px;">
    @if (!string.IsNullOrEmpty(Model.ArtworkUrl))
    {
        <img src="@Model.ArtworkUrl"
             alt="Artwork for @Model.Title"
             style="width:120px; height:120px; object-fit:cover; border-radius:8px;" />
    }

    <div>
        <h2>@Model.Title</h2>

        <p>
            <strong>Artist:</strong>
            @(Model.Artist?.Name ?? "Unknown")
        </p>

        <p>
            <strong>Duration:</strong>
            @duration.Minutes:@duration.Seconds.ToString("D2")
        </p>

        @if (!string.IsNullOrEmpty(Model.ApiSourceId))
        {
            <p><strong>API Source ID:</strong> @Model.ApiSourceId</p>
        }

        <p><strong>Playlists:</strong> @(Model.PlaylistTracks?.Count ?? 0)</p>
    </div>
</div>

<h3>Are you sure you want to delete this track?</h3>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TrackID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
