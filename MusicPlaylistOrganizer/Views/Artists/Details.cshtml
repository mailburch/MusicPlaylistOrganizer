@model MusicPlaylistOrganizer.Models.Artist

@{
    ViewData["Title"] = "Artist Details";
}

<h1>Artist Details</h1>

<div style="display:flex; gap:15px; align-items:flex-start; margin-bottom:20px;">
    @if (!string.IsNullOrEmpty(Model.ArtworkUrl))
    {
        <img src="@Model.ArtworkUrl"
             alt="Artwork for @Model.Name"
             style="width:150px; height:150px; object-fit:cover; border-radius:8px;" />
    }

    <div>
        <h2>@Model.Name</h2>

        @if (!string.IsNullOrEmpty(Model.Country))
        {
            <p><strong>Country:</strong> @Model.Country</p>
        }

        @if (!string.IsNullOrEmpty(Model.ApiSourceId))
        {
            <p><strong>API Source ID:</strong> @Model.ApiSourceId</p>
        }
    </div>
</div>

<hr />

<h3>Tracks by this Artist</h3>

@if (Model.Tracks == null || !Model.Tracks.Any())
{
    <p>No tracks found for this artist.</p>
}
else
{
    <ul>
        @foreach (var track in Model.Tracks.OrderBy(t => t.Title))
        {
            <li>@track.Title (@(track.DurationSeconds) sec)</li>
        }
    </ul>
}

<div style="margin-top:15px;">
    <a asp-action="Edit" asp-route-id="@Model.ArtistID" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
