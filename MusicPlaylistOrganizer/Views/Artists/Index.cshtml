@model IEnumerable<MusicPlaylistOrganizer.Models.Artist>

@{
    ViewData["Title"] = "Artists";
    var currentSearch  = ViewData["CurrentFilter"] as string;
    var currentCountry = ViewData["CurrentCountryFilter"] as string;
    var countries      = ViewBag.CountryOptions as List<string> ?? new List<string>();
}

<h1>Artists</h1>

<form asp-action="Index" method="get" class="form-inline" style="margin-bottom:15px;">
    <input type="text"
           name="searchString"
           value="@currentSearch"
           class="form-control"
           placeholder="Search by name or country..."
           style="max-width:260px; display:inline-block;" />

    <select name="countryFilter" class="form-control" style="max-width:180px; display:inline-block; margin-left:8px;">
        <option value="ALL">All Countries</option>
        @foreach (var c in countries)
        {
            <option value="@c" selected="@(currentCountry == c)">
                @c
            </option>
        }
    </select>

    <button type="submit" class="btn btn-outline-primary" style="margin-left:8px;">Apply</button>
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Artist</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Artwork</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["NameSortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-countryFilter="@currentCountry">
                    Name
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["CountrySortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-countryFilter="@currentCountry">
                    Country
                </a>
            </th>
            <th>Tracks</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var artist in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(artist.ArtworkUrl))
                {
                    <img src="@artist.ArtworkUrl"
                         alt="Artwork for @artist.Name"
                         style="width:60px; height:60px; object-fit:cover; border-radius:4px;" />
                }
            </td>
            <td>@artist.Name</td>
            <td>@artist.Country</td>
            <td>@(artist.Tracks?.Count ?? 0)</td>
            <td>
                <a asp-action="Details" asp-route-id="@artist.ArtistID">Details</a> |
                <a asp-action="Edit" asp-route-id="@artist.ArtistID">Edit</a> |
                <a asp-action="Delete" asp-route-id="@artist.ArtistID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
