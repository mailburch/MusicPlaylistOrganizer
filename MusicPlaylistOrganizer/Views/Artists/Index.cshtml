@model IEnumerable<MusicPlaylistOrganizer.Models.Artist>

@{
    ViewData["Title"] = "Artists";
    var currentSearch = ViewData["CurrentFilter"] as string;
    var currentGenre = ViewData["CurrentGenreFilter"] as string;
    var trackFilter = (ViewData["CurrentTrackFilter"] as string) ?? "all";
    var genre = ViewBag.GenreOptions as List<string> ?? new List<string>();
}
<h1>Artists</h1>
<div class="container-md">
    <div class="row">
        <div class="col-md-3">

            <div class="bg-blue p-4" style="border-radius: 1rem; height: 100%;">
                <p class="mb-0">Filters</p>
                <form asp-action="Index" method="get" class="form-inline" style="margin-bottom:15px;">
                    <input type="text"
                           name="searchString"
                           value="@currentSearch"
                           class="form-control formField"
                           placeholder="Search by name..."
                           style="max-width:260px; display:inline-block;" />

                    <select name="GenreFilter" class="form-control formField" style="max-width:220px; display:inline-block; margin-top:.5rem;">
                        <option value="ALL">Genre</option>
                        @foreach (var g in genre)
                        {
                            <option value="@g" selected="@(currentGenre == g)">
                                @g
                            </option>
                        }
                    </select>

                    <button type="submit" class="btn btn-blue mt-2 ps-3 pe-3 p-1">Apply</button>
                    <a asp-action="Index" class="btn btn-mute mt-2 ps-3 pe-3 p-1">Clear</a>
                </form>
                <p class="mb-0">Sort by</p>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["NameSortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-genreFilter="@currentGenre" class="btn btn-mute mt-0" style="width: 100%;">
                    Name
                </a>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["GenreSortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-genreFilter="@currentGenre" class="btn btn-mute mt-2" style="width: 100%;">
                    Genre
                </a>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["CountSortParm"]"
                   asp-route-searchString="@currentSearch"
                   asp-route-trackFilter="@trackFilter"
                   class="btn btn-mute mt-2"
                   style="width: 100%;"
                   style="text-decoration:none;">
                    Track Count
                </a>
            </div>
        </div>
        <div class="col-md-9">
            <h5 style="margin-left: .5%;">Your Artists</h5>
            <p>
                <a asp-action="Create" class="btn btn-blue">+ Add Artist</a>
            </p>

            <table class="table-mpo">
                <thead>
                    <tr>
                        <th>
                            <a asp-action="Index"
                               asp-route-sortOrder="@ViewData["NameSortParm"]"
                               asp-route-searchString="@currentSearch"
                               asp-route-genreFilter="@currentGenre" class="text-link-mute" style="text-decoration: none;">
                                ARTIST
                            </a>
                        </th>
                        <th>

                        </th>
                        <th class="text-mute">TRACKS</th>
                        <th class="text-mute">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artist in Model)
                    {
                        <tr class="track-row">
                            <td style="padding-right: .2rem;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                @if (!string.IsNullOrEmpty(artist.ArtworkUrl))
                                {
                                    <img src="@artist.ArtworkUrl"
                                         alt="Artwork for @artist.Name"
                                         style="width:50px; height:50px; object-fit:cover; border-radius:8px; margin: .4rem 0;" />
                                }
                                else
                                {
                                    <img src="~/Images/NoArtist.jpg"
                                         alt="Artwork missing for @artist.Name"
                                         style="width:50px; height:50px; object-fit:cover; border-radius:8px; margin: .4rem 0;" />

                                }
                                <div style="display: flex; flex-direction: column; justify-content: center;">
                                    <div style="line-height: 1.2;">
                                        <strong>@artist.Name</strong>
                                    </div>
                                        <div class="text-mute" style="line-height: 1.2;">@artist.Genre</div>
                                </div>
                                </div>
                            </td>
                            <td>

                            </td>
                            <td class="text-mute">@(artist.Tracks?.Count ?? 0) Tracks</td>
                            <td>
                                <a asp-action="Details" class="btn btn-other m-1 ms-0" asp-route-id="@artist.ArtistID">Details</a>
                                <a asp-action="Edit" class="btn btn-other m-1 ms-0" asp-route-id="@artist.ArtistID">Edit</a>
                                <a asp-action="Delete" class="btn btn-delete m-1 ms-0" asp-route-id="@artist.ArtistID">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>