@model MusicPlaylistOrganizer.Models.Artist

@{
    ViewData["Title"] = "Add Artist";
}

<h1>Add Artist</h1>

<div class="container-md bg-blue p-4" style="border-radius: 1rem">
    <div class="row">
        <h2>Search Artist from Online Catalog</h2>
        <div class="col-md-5">
            <div class="text-mute bg-blue" style="border-radius: 1rem; height: 100%;">
                <p>
                    Use this to search the iTunes catalog and import an artist directly
                    into your library. It will also apply artist country, as well as artwork.
                </p>


                <input type="text"
                       id="artistQuery"
                       placeholder="Search for an artist..."
                       class="form-control formField"
                       style="max-width: 500px; display: inline-block;" />
                <button type="button" id="artistSearchBtn" class="btn btn-other mt-2">Search</button>
                <div id="artistSearchResults" style="margin-top:15px;"></div>
            </div>


        </div>
        <div class="col-md-7">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group" style="margin-top: 10px;">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control formField" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group" style="margin-top:10px;">
                    <label asp-for="Country"></label>
                    <input asp-for="Country" class="form-control formField" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>

                <div class="form-group" style="margin-top:10px;">
                    <label asp-for="ArtworkUrl">Artwork URL</label>
                    <input asp-for="ArtworkUrl" class="form-control formField" />
                    <span asp-validation-for="ArtworkUrl" class="text-danger"></span>
                </div>

                <input asp-for="ApiSourceId" type="hidden" />

                <div style="margin-top:15px;">
                    <button type="submit" class="btn btn-blue me-4" ">Create</button>
                    <a asp-action="Index" class="btn btn-mute">Cancel</a>
                </div>

            </form>
        </div>
    </div>




    @section Scripts {
        <script>
            document.getElementById('artistSearchBtn').addEventListener('click', function () {
                const query = document.getElementById('artistQuery').value;
                if (!query) return;

                fetch('/Catalog/SearchArtists?query=' + encodeURIComponent(query))
                    .then(r => r.json())
                    .then(data => {
                        const container = document.getElementById('artistSearchResults');
                        container.innerHTML = '';

                        if (!data || data.length === 0) {
                            container.innerHTML = '<p>No results.</p>';
                            return;
                        }

                        const list = document.createElement('ul');
                        list.style.listStyle = "none";
                        list.style.padding = "0";

                        data.forEach(item => {
                            const li = document.createElement('li');
                                                            li.style.backgroundColor = "#23274a";
                                    li.style.padding = "2%";
                                    li.style.borderRadius = "10px";
                            li.style.display = "flex";
                            li.style.alignItems = "center";
                            li.style.gap = "10px";
                            li.style.marginBottom = "10px";

                            if (item.artworkUrl100) {
                                const img = document.createElement('img');
                                img.src = item.artworkUrl100;
                                img.alt = item.artistName;
                                img.style.width = "50px";
                                img.style.height = "50px";
                                img.style.objectFit = "cover";
                                img.style.borderRadius = "4px";
                                li.appendChild(img);
                            }

                            const text = document.createElement('span');
                            let label = item.artistName;
                            if (item.primaryGenreName) {
                                label += " — " + item.primaryGenreName;
                            }
                            text.textContent = label;

                            const btn = document.createElement('button');
                            btn.textContent = "Select";
                            btn.className = "btn btn-sm btn-mute ps-3 pe-3 p-1"
                            btn.style.marginLeft = "auto";
                            btn.addEventListener('click', function () {
                                const nameInput = document.getElementById('Name');
                                const countryInput = document.getElementById('Country');
                                const artworkInput = document.getElementById('ArtworkUrl');
                                const apiSourceInput = document.getElementById('ApiSourceId');

                                if (nameInput) nameInput.value = item.artistName || "";
                                if (countryInput && item.primaryGenreName) {
                                    countryInput.value = item.primaryGenreName;
                                }
                                if (artworkInput && item.artworkUrl100) {
                                    artworkInput.value = item.artworkUrl100;
                                }
                                if (apiSourceInput && item.artistId) {
                                    apiSourceInput.value = item.artistId.toString();
                                }
                            });

                            li.appendChild(text);
                            li.appendChild(btn);
                            list.appendChild(li);
                        });

                        container.appendChild(list);
                    });
            });
        </script>
    }
</div>