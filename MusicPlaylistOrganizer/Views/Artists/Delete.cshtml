@model MusicPlaylistOrganizer.Models.Artist

@{
    ViewData["Title"] = "Delete Artist";
}

<h1>Delete Artist</h1>
<div class="container-md">
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-6 ps-5 pe-5 p-3 bg-blue" style="border-color: red; border-width: 2px; border-radius: 1rem; border-style: solid;">
            <div>
                <h2 class="text-danger">Delete Track?</h2>
                <div style="display:flex; gap:15px; align-items:flex-start; margin-bottom:20px;">
                    @if (!string.IsNullOrEmpty(Model.ArtworkUrl))
                    {
                        <img src="@Model.ArtworkUrl"
                             alt="Artwork for @Model.Name"
                             style="width:120px; height:120px; object-fit:cover; border-radius:8px;" />
                    }
                    else
                    {
                        <img src="~/Images/NoArtist.jpg"
                             alt="Artwork missing for @Model.Name"
                             style="width:120px; height:120px; object-fit:cover; border-radius:8px;" />
                    }

                    <div>
                        <h3>@Model.Name</h3>

                        @if (!string.IsNullOrEmpty(Model.Genre))
                        {
                            <h5 class="text-mute">@Model.Genre</h5>
                        }

                    </div>
                </div>

@if (Model.Tracks != null && Model.Tracks.Any())
{
                    <p class="text-warning">
                        ⚠️ This artist cannot be deleted because they still have tracks in the system
                        (and possibly in playlists). Remove or reassign those tracks first.
                    </p>

                    <div style="margin-top:10px;">
                        <a asp-action="Index" class="btn btn-mute pe-5 ps-5 p-1">Back</a>
                    </div>
}
else
{
                    <p class="text-mute">
                        This will remove the artist from your library.
                    </p>
                    <p class="text-danger">Are you sure you want to delete this artist?</p>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ArtistID" />
                        <button type="submit" class="btn btn-delete mt-5 me-5 ps-5 pe-5" style="border-radius: 2rem;">Delete</button>
                        <a asp-action="Index" class="btn btn-other mt-5 me-5 ps-5 pe-5" style="border-radius: 2rem;">Cancel</a>
                    </form>
}
